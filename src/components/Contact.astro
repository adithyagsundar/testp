---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section id="contact" class="block page contact" aria-labelledby="ct-h">
  <h2 id="ct-h" class="contact__h" data-split data-parse><span class="pc" data-cat="VP">Let's build</span> <span class="pc" data-cat="NP">something.</span></h2>
  <p class="contact__sub" data-reveal>Open to software engineering internships. Email is the fastest way to reach me.</p>
  <ul class="contact__links">
    <li data-reveal><a class="btn btn--primary" href={`mailto:${site.email}`} data-magnetic><Icon name="mail" /> {site.email}</a></li>
    <li data-reveal><a class="btn" href={site.linkedin} data-magnetic><Icon name="linkedin" /> LinkedIn</a></li>
    <li data-reveal><a class="btn" href={site.github} data-magnetic><Icon name="github" /> GitHub</a></li>
    <li data-reveal><a class="btn" href={site.resume} data-magnetic><Icon name="download" /> Resume</a></li>
  </ul>
</section>
<style>
  .contact { padding-bottom: var(--s-9); }
  .contact__h { font-size: clamp(2.4rem, 1.4rem + 4.4vw, 4.8rem); letter-spacing: -0.035em; line-height: 1.2; }
  .contact__sub { margin-top: var(--s-4); color: var(--ink-2); font-size: var(--step-1); }
  .contact__links { display: flex; flex-wrap: wrap; gap: var(--s-3); list-style: none; margin-top: var(--s-6); }
</style>
