---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpeg';
import Icon from './Icon.astro';
import { site, proof } from '../data/site';
// Phrase groups keep the decorative underlines aligned when text wraps.
const parse = [
  { words: ['Adithya'] },
  { words: ['builds'] },
  { words: ['backends,', 'pipelines,', 'and', 'infrastructure.'] },
];
---
<section id="top" class="hero" aria-labelledby="hero-h" data-hero>
  <canvas class="hero__field" aria-hidden="true" data-field></canvas>
  <div class="page hero__inner">
    <div class="hero__copy">
      <h1 id="hero-h" class="hero__h" data-letters data-parse>
        <span class="visually-hidden">{site.name}: </span>
        {parse.map((c) => (
          <span class="pc">{c.words.map((w) => <span class="hero__w">{w}</span>)}</span>
        ))}
      </h1>

      <p class="hero__sub" data-hero-in>
        Software engineer studying Computer Science &amp; Linguistics at UCLA.
      </p>

      <div class="hero__actions" data-hero-in>
        <a class="btn btn--primary" href={site.resume} data-magnetic>
          <Icon name="download" /> Resume
        </a>
        <a class="btn" href={site.github} data-magnetic>
          <Icon name="github" /> GitHub
        </a>
        <button class="btn" type="button" data-copy-email={site.email} data-magnetic aria-label={`Copy email address ${site.email}`}>
          <span class="copy-swap">
            <span class="copy-swap__a"><Icon name="mail" /> {site.email}</span>
            <span class="copy-swap__b" aria-hidden="true"><Icon name="check" /> Copied</span>
          </span>
        </button>
      </div>

      <ul class="hero__proof" aria-label="Highlights" data-hero-in>
        {proof.map((p) => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
      </ul>
    </div>

    <figure class="portrait" data-portrait>
      <div class="portrait__frame" data-portrait-frame>
        <Image
          src={headshot}
          alt="Portrait of Adithya Gnanasundar"
          widths={[360, 540, 720, 960]}
          sizes="(max-width: 860px) 9rem, 30vw"
          class="portrait__img"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </figure>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3rem, 9vh, 6rem) clamp(4rem, 10vh, 7rem);
  }

  .hero__field {
    position: absolute;
    inset: -4.25rem 0 0;
    z-index: -1;
    width: 100%;
    height: calc(100% + 4.25rem);
    pointer-events: none;
    -webkit-mask-image: radial-gradient(110% 85% at 75% 20%, #000 25%, transparent 72%);
    mask-image: radial-gradient(110% 85% at 75% 20%, #000 25%, transparent 72%);
  }

  .hero__h {
    max-width: 15ch;
    font: 620 clamp(2.6rem, 1.4rem + 4.6vw, 5.3rem) / 1.2 var(--font-display);
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .hero__w { display: inline-block; margin-right: 0.24em; }
  .hero__w :global(.ch) { display: inline-block; will-change: transform; }

  .hero__sub {
    margin-top: var(--s-5);
    max-width: 38ch;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  .hero__proof { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); margin-top: var(--s-7); list-style: none; }
  .hero__proof a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink-2);
    font-size: var(--step--1);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .hero__proof a::before {
    content: '';
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--hl);
    box-shadow: 0 0 0 1px var(--hl-ink);
    transition: scale 320ms var(--ease-out), box-shadow 320ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .hero__proof a:hover { color: var(--ink); } }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .hero__proof a:hover::before { scale: 1.3; box-shadow: 0 0 0 4px color-mix(in oklab, var(--hl) 25%, transparent); }
  }

  /* Portrait: a soft card that tilts toward the pointer (springs, see effects.ts) */
  .portrait {
    position: relative;
    margin: 0;
    justify-self: end;
    width: min(100%, 25rem);
    perspective: 900px;
  }
  .portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--rule);
    box-shadow: var(--shadow);
    transform-style: preserve-3d;
    will-change: transform;
  }
  .portrait__frame :global(.portrait__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
    transform: scale(1.04);
    will-change: transform;
  }


  /* Copy email: label morphs with a blur bridge */
  .copy-swap { display: inline-grid; min-width: 0; }
  .copy-swap > span {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    transition: opacity 240ms ease, filter 240ms ease, transform 280ms var(--ease-out);
  }
  .copy-swap__a { overflow-wrap: anywhere; }
  .copy-swap__b { opacity: 0; filter: blur(3px); transform: translateY(4px); justify-content: center; }
  [data-copied] .copy-swap__a { opacity: 0; filter: blur(3px); transform: translateY(-4px); }
  [data-copied] .copy-swap__b { opacity: 1; filter: none; transform: none; }

  @media (max-width: 860px) {
    .hero__inner { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .portrait { order: -1; justify-self: start; width: 9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__field { display: none; }
  }
</style>
