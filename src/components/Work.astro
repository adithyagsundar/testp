---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const dev = import.meta.env.DEV && import.meta.env.PUBLIC_SHOW_TODO === 'true'; // run with PUBLIC_SHOW_TODO=true to see missing evidence
---
<section id="work" class="block page" aria-labelledby="work-h">
  <h2 id="work-h" class="block__h" data-split data-parse><span class="pc">Selected</span> <span class="pc">work</span></h2>

  <ol class="work">
    {projects.map((p) => (
      <li class="work__item" data-reveal data-work>
        <span class="work__glow" aria-hidden="true"></span>
        <div class="work__main">
          <h3 class="work__title">
            <a href={`/work/${p.id}/`} class="work__link" style={`view-transition-name: t-${p.id}`}>
              <span class="hover-ink">{p.data.title}</span>
              <Icon name="arrow-up-right" />
            </a>
          </h3>
          <p class="work__desc">{p.data.translation}</p>
          {p.data.stack.length > 0 && <p class="work__stack">{p.data.stack.join(' · ')}</p>}
          {dev && p.data.todo.length > 0 && <p class="todo">TODO: {p.data.todo.join(' · ')}</p>}
        </div>
        <p class="work__ctx">{p.data.context.split(' · ')[0]}<br /><span class="tabular">{p.data.period}</span></p>
      </li>
    ))}
  </ol>

</section>

<style>
  .work { list-style: none; }
  .work__item {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-3) var(--s-6);
    padding-block: var(--s-5);
  }
  /* Divider draws in from the left as the row arrives */
  .work__item::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--rule);
    transform-origin: 0 50%;
    transition: transform 1.2s var(--ease-out);
  }
  :global(html.js) .work__item:not([data-in])::before { transform: scaleX(0); }
  .work__item:last-child { border-bottom: 1px solid var(--rule); }
  .work__main { display: grid; gap: var(--s-2); min-width: 0; }
  .work__title { font-size: var(--step-2); letter-spacing: -0.025em; }
  .work__link {
    display: inline;
    color: var(--ink);
    text-decoration: none;
  }
  .work__link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .work__link:focus-visible { outline: none; }
  .work__item:has(.work__link:focus-visible) { outline: 2px solid var(--focus); outline-offset: 4px; border-radius: var(--radius); }
  .work__link :global(svg) {
    width: 0.65em;
    height: 0.65em;
    margin-left: 0.3em;
    color: var(--ink-3);
    transition: translate 320ms var(--ease-out), color 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .work__item:hover .work__link :global(svg) { translate: 3px -3px; color: var(--ink); }
  }
  .work__link:focus-visible :global(svg) { translate: 3px -3px; color: var(--ink); }
  @media (prefers-reduced-motion: reduce) {
    .work__link :global(svg) { transition: none; translate: none !important; }
  }
  .work__desc { color: var(--ink-2); max-width: 60ch; }
  .work__stack { color: var(--ink-3); font-size: var(--step--1); }
  .work__ctx { color: var(--ink-3); font-size: var(--step--1); text-align: right; line-height: 1.5; padding-top: 0.4rem; }
  .todo { position: relative; z-index: 2; }


  @media (max-width: 640px) {
    .work__item { grid-template-columns: 1fr; }
    .work__ctx { text-align: left; padding-top: 0; order: -1; }
    .work__ctx br { display: none; }
    .work__ctx span::before { content: ' · '; }
  }
</style>
